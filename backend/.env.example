# ========================================
# LLM 模型配置
# ========================================

# 模型提供商和模型名称
# 豆包/火山方舟：通过 OpenAI 兼容接口接入
# 使用基础模型名（经 /api/v3 实测可用）；推理接入点 ID（ark-... 格式）需账号下真实存在
LLM_PROVIDER=volcengine
LLM_MODEL=doubao-seed-2-0-code-preview-260215

# API Endpoint（火山方舟 OpenAI 兼容 Base URL）
# 注意：/api/v3 为普通 Chat Completions 端点；/api/plan/v3 为 Agent Plan 端点（仅部分模型支持）
LLM_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# API Key（火山方舟 API Key，在控制台「API Key 管理」创建，勿与模型接入点 ID 混用）
LLM_API_KEY=your_volcengine_ark_api_key_here

# 是否启用 mock 模式
LLM_MOCK_MODE=false

# SSL 证书验证
LLM_SSL_VERIFY=true

# 可选: API Base URL (某些提供商需要)
# LLM_API_BASE=

# ========================================
# 其他配置
# ========================================

# 应用环境 (development/production)
ENVIRONMENT=development

# 服务器端口
PORT=8000

# 浏览器来源配置。显式来源以逗号分隔；默认同时允许下列端口上的
# 10/8、172.16/12、192.168/16 私有 IPv4，适配局域网 DHCP 地址变化。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ALLOW_PRIVATE_NETWORK=true
CORS_PRIVATE_PORTS=5173,5174,5175
